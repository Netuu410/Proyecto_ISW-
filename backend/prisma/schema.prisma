generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. El Catálogo
model CatalogoItem {
  id           Int                 @id @default(autoincrement())
  nombre       String
  categoria    String
  precioVenta  Float
  costoInterno Float
  detalles     DetalleCotizacion[]
}

// 2. La Cabecera de la Cotización
model Cotizacion {
  id           Int                 @id @default(autoincrement())
  clienteId    Int
  fecha        DateTime            @default(now())
  estado       String              @default("Preliminar")
  totalVenta   Float
  gananciaNeta Float
  items        DetalleCotizacion[]
}

// 3. El Detalle (Tabla intermedia)
model DetalleCotizacion {
  id            Int   @id @default(autoincrement())
  cantidad      Int
  precioCobrado Float
  costoAsumido  Float

  cotizacion     Cotizacion   @relation(fields: [cotizacionId], references: [id])
  cotizacionId   Int
  item           CatalogoItem @relation(fields: [catalogoItemId], references: [id])
  catalogoItemId Int
}

// 4. Equipos de Inventario
model Equipo {
  id          Int             @id @default(autoincrement())
  nombre      String
  categoria   String
  imagenUrl   String?
  descripcion String?
  estado      String?         @default("Disponible")
  precio      Float?          @default(0)
  createdAt   DateTime        @default(now())
  stock       Int             @default(1)
  origen      String          @default("Propio")
  reportes    ReporteAveria[]
  alertas     AlertaStock[]
  reservasAgenda ReservaEquipo[]
}

model ReporteAveria {
  id          Int          @id @default(autoincrement())
  equipoId    Int
  descripcion String
  createdAt   DateTime     @default(now())
  equipo      Equipo       @relation(fields: [equipoId], references: [id])
  alerta      AlertaStock?
}

model AlertaStock {
  id        Int           @id @default(autoincrement())
  equipoId  Int
  reporteId Int           @unique
  mensaje   String
  createdAt DateTime      @default(now())
  equipo    Equipo        @relation(fields: [equipoId], references: [id])
  reporte   ReporteAveria @relation(fields: [reporteId], references: [id])
}

// 5. Eventos realizados por la productora
model Evento {
  id           Int          @id @default(autoincrement())
  nombre       String
  estado       String       @default("Pendiente")
  fecha        DateTime
  createdAt    DateTime     @default(now())
  evaluaciones Evaluacion[]
  actividadAgenda ActividadAgenda?
}

// 6. Personal eventual y proveedores
model Colaborador {
  id           Int          @id @default(autoincrement())
  nombre       String
  tipo         String
  telefono     String?
  email        String?
  createdAt    DateTime     @default(now())
  evaluaciones Evaluacion[]
}

// 7. Evaluaciones de desempeño
model Evaluacion {
  id          Int      @id @default(autoincrement())
  estrellas   Int
  notaInterna String?
  fecha       DateTime @default(now())

  evento   Evento @relation(fields: [eventoId], references: [id])
  eventoId Int

  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id])
  colaboradorId Int
}

enum TipoActividadAgenda {
  EVENTO
  VISITA_TECNICA
}

model Recinto {
  id          Int               @id @default(autoincrement())
  nombre      String
  direccion   String
  clave       String            @unique
  actividades ActividadAgenda[]
}

model ActividadAgenda {
  id             Int                 @id @default(autoincrement())
  tipo           TipoActividadAgenda
  nombre         String
  clienteNombre  String
  inicio         DateTime            @db.Timestamptz(3)
  fin            DateTime            @db.Timestamptz(3)
  estado         String              @default("Reservado")
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  recintoId      Int
  recinto        Recinto             @relation(fields: [recintoId], references: [id])
  eventoId       Int?                @unique
  evento         Evento?             @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  reservasEquipo ReservaEquipo[]

  @@index([inicio, fin])
}

model ReservaEquipo {
  id          Int             @id @default(autoincrement())
  actividadId Int
  actividad   ActividadAgenda @relation(fields: [actividadId], references: [id])
  equipoId    Int
  equipo      Equipo          @relation(fields: [equipoId], references: [id])
  cantidad    Int

  @@unique([actividadId, equipoId])
  @@index([equipoId])
}
