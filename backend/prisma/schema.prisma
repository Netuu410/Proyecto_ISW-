generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. El Catálogo
model CatalogoItem {
  id           Int                 @id @default(autoincrement())
  nombre       String
  categoria    String
  precioVenta  Float
  costoInterno Float
  detalles     DetalleCotizacion[]
}

// 2. La Cabecera de la Cotización
model Cotizacion {
  id           Int                 @id @default(autoincrement())
  clienteId    Int
  fecha        DateTime            @default(now())
  estado       String              @default("Preliminar")
  totalVenta   Float
  gananciaNeta Float
  items        DetalleCotizacion[]
}

// 3. El Detalle (Tabla intermedia)
model DetalleCotizacion {
  id             Int          @id @default(autoincrement())
  cantidad       Int
  precioCobrado  Float
  costoAsumido   Float

  cotizacion     Cotizacion   @relation(fields: [cotizacionId], references: [id])
  cotizacionId   Int
  item           CatalogoItem @relation(fields: [catalogoItemId], references: [id])
  catalogoItemId Int
}

// 4. Equipos de Inventario
model Equipo {
  id        Int      @id @default(autoincrement())
  nombre      String
  categoria   String
  imagenUrl   String?
  descripcion String?
  estado      String?  @default("Disponible")
  precio      Float?   @default(0)
  createdAt   DateTime @default(now())
}

// 5. Eventos realizados por la productora
model Evento {
  id        Int      @id @default(autoincrement())
  nombre    String
  estado    String   @default("Pendiente")
  fecha     DateTime
  createdAt DateTime @default(now())
}

// 6. Personal eventual y proveedores
model Colaborador {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      String
  telefono  String?
  email     String?
  createdAt DateTime @default(now())
}